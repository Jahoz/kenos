{
  "output": {
    "filePath": "repomix-output.md",
    "style": "xml",
    "compress": true,
    "removeEmptyLines": true,
    "truncateBase64": true,
    "headerText": "kenos - Pack Codebase",
    "instructionFilePath": ".repomix/instructions.md",
    "tokenCountEncoding": "o200k_base"
  },
  "security": {
    "enableSecurityCheck": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "node_modules",
      "vendor",
      "dist",
      "build",
      ".astro",
      ".supabase",
      ".vercel",
      ".npm-cache",
      ".flutter-plugins",
      ".dart_tool",
      "AI_CONTEXT.md",
      "MILESTONE_LOG.md",
      "repomix-output.md",
      "*.log",
      "*.lock",
      "package-lock.json",
      "composer.lock",
      "pnpm-lock.yaml",
      "bun.lockb",
      "*.min.js",
      "*.min.css",
      "*.map",
      ".DS_Store",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.svg",
      "*.webp",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot",
      "*.wasm",
      "*.wav",
      ".next",
      "supabase/.temp",
      "**/seed*.sql",
      "test-results",
      "coverage",
      "android",
      "ios",
      "linux",
      "macos",
      "windows",
      "web",
      "*.g.dart",
      "*.freezed.dart"
    ]
  }
}
